# Coolify katmanı: Build
# Zorunlu. next build bu değer yoksa düşer; robots.ts ve sitemap.ts bunu okur.
# Kanonik host www.kenet.app'tir (karar 2026-11-13); kenet.app kalıcı yönlendirmeyle www'ye gider.
NEXT_PUBLIC_SITE_URL=https://www.kenet.app

# Coolify katmanı: Build
# İsteğe bağlı. Derlenen commit ve derleme zamanı, altbilgide gösterilir.
# CI github.sha ve commit zamanını geçer; boş bırakılırsa Dockerfile Coolify'ın
# SOURCE_COMMIT değerine ve derleme anındaki UTC saate düşer.
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_BUILD_DATE=
